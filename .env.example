# Base URL of the Time Capsule API, including the version prefix and a trailing slash.
# Matches the Laravel backend's `api/v1` Fortify/route prefix.
VUE_APP_API_BASE_URL=http://localhost/api/v1/

# Run against an in-memory fixture backend instead of HTTP. Useful for demos,
# screenshots and reviewing the UI with no Laravel instance running.
VUE_APP_DEMO=false

# Capsules rendered per page in the list view.
VUE_APP_PAGE_SIZE=8
