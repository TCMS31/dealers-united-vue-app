{
  "name": "time-capsule-app",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 client for the Time Capsule API: write a note, seal it, and read it when its opening time passes.",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO=true vite",
    "build": "vite build",
    "build:demo": "cross-env VITE_DEMO=true vite build",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"tests/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "vue": "^3.4.21",
    "vue-cookies": "^1.8.3",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "type": "module"
}
